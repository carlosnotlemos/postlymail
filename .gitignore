# Dependências do Ruby
/.bundle/
/vendor/bundle/

# Logs e Arquivos Temporários (mantendo a estrutura de pastas)
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep
/storage/*
!/storage/.keep

# Banco de Dados local (apenas arquivos SQLite/dumps)
*.sqlite3
*.sqlite3-journal

# Assets Compilados
/public/assets/
/public/packs/
/public/vite/

# Chaves e Credenciais
/config/master.key
/config/credentials/*.key

# Variáveis de Ambiente
.env*
!.env.example

# Node / Frontend
/node_modules/
/yarn-error.log
/npm-debug.log
/yarn-debug.log

# Ferramentas de Teste e Lint
/coverage/
/.rubocop-https?/

# Editor / Sistema Operacional
.vscode/
.idea/
*.swp
*.swo
.DS_Store